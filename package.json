{
  "name": "desk-racer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "[ -d node_modules/.bin ] || bun install || npm install",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "[ -d node_modules/.bin ] || bun install || npm install",
    "build": "vite build",
    "prelint": "[ -d node_modules/.bin ] || bun install || npm install",
    "lint": "tsc --noEmit",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "android:add": "cap add android && node scripts/patch-android.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/orbitron": "^5.1.0",
    "@fontsource/press-start-2p": "^5.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.183.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "typescript": "~5.8.2",
    "@capacitor/cli": "^7.0.0"
  }
}
